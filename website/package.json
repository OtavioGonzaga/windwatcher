{
  "name": "windwatcher-docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "prepare:content": "bun scripts/prepare-content.ts",
    "openapi": "bun scripts/export-openapi.ts",
    "generate": "bun run openapi && bun run prepare:content",
    "dev": "bun run generate && bun --bun next dev --webpack",
    "build": "bun run generate && bun --bun next build --webpack",
    "test": "bun test ./tests/*.test.ts",
    "validate": "bun scripts/validate.ts",
    "preview": "bun scripts/preview.ts",
    "test:e2e": "bun --bun playwright test",
    "check": "bun run generate && bun --bun fumadocs-mdx && bun --bun next typegen && bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write . --ignore-path .prettierignore",
    "format:check": "bun --bun prettier --check . --ignore-path .prettierignore"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "flexsearch": "0.8.212",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.8",
    "fumadocs-ui": "16.17.10",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "3.9.10",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
