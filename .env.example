# Windwatcher does not automatically load .env files. Load this through your shell,
# container, or service manager when desired.
WINDWATCHER__STORAGE__SQLITE__CREATE_IF_MISSING=true
WINDWATCHER__STORAGE__SQLITE__MAX_CONNECTIONS=8
WINDWATCHER__STORAGE__SQLITE__BUSY_TIMEOUT=5s
WINDWATCHER__AUTH__REGISTRATION=closed
WINDWATCHER__AUTH__SESSION__ACCESS_TOKEN_TTL=15m
WINDWATCHER__AUTH__SESSION__SESSION_TTL=30d
WINDWATCHER__AUTH__JWT__ISSUER=windwatcher
WINDWATCHER__AUTH__JWT__SECRET_FILE=/etc/windwatcher/jwt.key
# WINDWATCHER__AUTH__JWT__SECRET=replace-with-a-secret-at-least-32-bytes-long
WINDWATCHER__LOGGING__FILTER=info
WINDWATCHER__LOGGING__FORMAT=compact
