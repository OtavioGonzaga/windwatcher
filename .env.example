# Windwatcher does not automatically load .env files. Load this through your shell,
# container, or service manager when desired.
WINDWATCHER__STORAGE__SQLITE__CREATE_IF_MISSING=true
WINDWATCHER__STORAGE__SQLITE__MAX_CONNECTIONS=8
WINDWATCHER__STORAGE__SQLITE__BUSY_TIMEOUT=5s
WINDWATCHER__AUTH__REGISTRATION=closed
WINDWATCHER__AUTH__SESSION__ACCESS_TOKEN_TTL=15m
WINDWATCHER__AUTH__SESSION__SESSION_TTL=30d
WINDWATCHER__AUTH__JWT__ISSUER=windwatcher
WINDWATCHER__AUTH__JWT__SECRET_FILE=/etc/windwatcher/jwt.key
# WINDWATCHER__AUTH__JWT__SECRET=replace-with-a-secret-at-least-32-bytes-long
# Inclusive UTF-8 byte limit for new sends/edits (128 KiB).
WINDWATCHER__MESSAGES__MAX_CONTENT_BYTES=131072
WINDWATCHER__HTTP__CORS__ALLOWED_ORIGINS='[]'
WINDWATCHER__HTTP__RATE_LIMIT__ENABLED=true
WINDWATCHER__HTTP__RATE_LIMIT__GENERAL__REQUESTS=100
WINDWATCHER__HTTP__RATE_LIMIT__GENERAL__PERIOD=1s
WINDWATCHER__HTTP__RATE_LIMIT__GENERAL__BURST=200
WINDWATCHER__HTTP__RATE_LIMIT__AUTH__REQUESTS=10
WINDWATCHER__HTTP__RATE_LIMIT__AUTH__PERIOD=1m
WINDWATCHER__HTTP__RATE_LIMIT__AUTH__BURST=10
WINDWATCHER__REALTIME__TICKET_TTL=30s
WINDWATCHER__REALTIME__OUTGOING_BUFFER=32
WINDWATCHER__REALTIME__HEARTBEAT_INTERVAL=30s
WINDWATCHER__REALTIME__HEARTBEAT_TIMEOUT=10s
WINDWATCHER__REALTIME__SESSION_RECHECK_INTERVAL=30s
WINDWATCHER__REALTIME__DISPATCH_CONCURRENCY=32
WINDWATCHER__REALTIME__DISPATCH_TIMEOUT=5s
WINDWATCHER__LOGGING__FILTER=info
WINDWATCHER__LOGGING__FORMAT=compact
