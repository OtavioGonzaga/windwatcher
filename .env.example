# .env.example - variáveis de ambiente de exemplo para Windwatcher
# Copie este ficheiro para `.env` e preencha os valores sensíveis antes de usar em produção.

# URL de conexão com a base de dados. Exemplos:
# - SQLite (padrão local, criado automaticamente se não existir):
#   WINDWATCHER_DATABASE_URL=sqlite://windwatcher_local_data.db?mode=rwc
# - PostgreSQL:
#   WINDWATCHER_DATABASE_URL=postgresql://user:pass@localhost/windwatcher
# - MySQL/MariaDB:
#   WINDWATCHER_DATABASE_URL=mysql://user:pass@localhost/windwatcher

WINDWATCHER_DATABASE_URL=sqlite://windwatcher_local_data.db?mode=rwc
# Opcional: força o provider (postgres, mysql, sqlite, mongodb). Normalmente auto-detectado.
WINDWATCHER_DATABASE_PROVIDER=sqlite

# Fila de background planejada para Apalis.
# Providers: memory, sqlite, postgres, mysql, redis.
WINDWATCHER_QUEUE_PROVIDER=sqlite
WINDWATCHER_QUEUE_URL=sqlite://windwatcher_jobs.db?mode=rwc
WINDWATCHER_QUEUE_NAME=chat_messages
WINDWATCHER_QUEUE_CONCURRENCY=4

# Host e porta do servidor HTTP
WINDWATCHER_SERVER_HOST=0.0.0.0
WINDWATCHER_SERVER_PORT=3000

# JWT - altere para um segredo forte antes de colocar em produção
WINDWATCHER_JWT_SECRET=change-this-secret-in-production
# Tempo de validade do JWT em segundos (padrão: 86400 = 24 horas)
WINDWATCHER_JWT_EXPIRY_SECS=86400

# Logging (opcional)
RUST_LOG=windwatcher=info,sea_orm=warn
